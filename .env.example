# ============================================
# Agentic QA — Environment Variables Template
# ============================================
# Copy this file to .env and fill in your actual values.
# NEVER commit your real .env file to version control.

# ── Required ─────────────────────────────────
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_API_BASE=https://api.openai.com/v1
MODEL_NAME=gpt-4o-mini

# ── Judge ─────────────────────────────────────
# Use a different (ideally stronger) model for the LLM judge than for generation
# JUDGE_MODEL_NAME=gpt-4o
# llm | jev | cascade | ensemble | auto (auto = cascade when a Jev key is set)
JUDGE_BACKEND=auto
# A stronger model reviews generated tests for wrong expectations before judging
# (gpt-4o-mini accepts everything). JUDGE_VALIDITY_CHECK=0 turns the review off.
# JUDGE_VALIDITY_MODEL=gpt-4o
# JUDGE_VALIDITY_CHECK=1
# JUDGE_BATCH_SIZE=8             # tests per judge call (big batches make models skip tests)
# JUDGE_CONTEXT_CHARS=2000       # characters per retrieved chunk shown to the judge

# ── Optional: Jev probabilistic judge ─────────
# pip install typesafe-sdk
# FREE: OpenCode Zen serves jev-1.13-free (limited time). Get a key at
# https://opencode.ai (Zen). Falls back to paid jev-1.13 automatically if the
# free model is withdrawn. Free-tier inputs may be used for training — don't
# send confidential data on the free model.
# Keep commented until you have a real key: setting it enables Jev automatically.
# OPENCODE_API_KEY=your-opencode-zen-api-key-here
# Or TypeSafe directly (paid, jev-latest):
# TYPESAFE_API_KEY=your-typesafe-api-key-here
# JEV_PROVIDER=auto              # auto | opencode | typesafe
# JEV_MODEL=jev-1.13-free        # set jev-1.13 for the paid model
# JEV_FALLBACK_MODEL=jev-1.13    # "none" to disable fallback
# JEV_PASS_THRESHOLD=0.5         # tune with: agentic-qa calibrate
# JEV_CASCADE_LOW=0.3            # cascade: P(pass) in [LOW, HIGH] -> LLM judge
# JEV_CASCADE_HIGH=0.7

# ── Optional: RAGAS metrics (extra LLM cost) ──
# pip install "agentic-qa[ragas]"
ENABLE_RAGAS=0

# ── Optional: LangSmith Tracing ──────────────
# Get your key at https://smith.langchain.com
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=lsv2_your-langsmith-api-key-here
LANGCHAIN_PROJECT=agentic-qa
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ── Pipeline Configuration ────────────────────
MAX_ITERATIONS=3
TESTS_PER_ITERATION=5
EXECUTOR_MAX_WORKERS=4
EXECUTOR_TIMEOUT=60
REGRESSION_MEMORY_REPLAY=3
# POLICY_TESTS_PER_ITERATION=2   # policy rules the red team must attack each iteration
# Memory is per system: reports/regression_memory/<system name>.json. Override with one file:
# REGRESSION_MEMORY_PATH=reports/regression_memory.json
# REPORTS_DIR=reports
# AUTO_OPEN_REPORT=1
# Cost estimates (USD per 1M tokens) for models not in the built-in table:
# LLM_PRICES_JSON={"gpt-4o-mini": [0.15, 0.60]}
